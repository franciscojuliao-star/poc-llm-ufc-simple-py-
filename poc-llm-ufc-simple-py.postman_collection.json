    {
      "name": "Quiz — Manual",
      "item": [
        {
          "name": "Criar quiz com perguntas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/modules/{{module_id}}/quiz", "host": ["{{base_url}}"], "path": ["modules", "{{module_id}}", "quiz"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questions\": [\n    {\n      \"statement\": \"O que é uma list comprehension em Python?\",\n      \"points\": 1,\n      \"alternatives\": [\n        { \"text\": \"Uma forma concisa de criar listas\", \"correct\": true },\n        { \"text\": \"Um tipo de laço while\", \"correct\": false },\n        { \"text\": \"Uma função embutida do Python\", \"correct\": false },\n        { \"text\": \"Um método de ordenação\", \"correct\": false }\n      ]\n    },\n    {\n      \"statement\": \"Qual comando cria um novo projeto Rails?\",\n      \"points\": 1,\n      \"alternatives\": [\n        { \"text\": \"rails new\", \"correct\": true },\n        { \"text\": \"rails create\", \"correct\": false },\n        { \"text\": \"rails init\", \"correct\": false },\n        { \"text\": \"rails start\", \"correct\": false }\n      ]\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Ver quiz do módulo",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/modules/{{module_id}}/quiz", "host": ["{{base_url}}"], "path": ["modules", "{{module_id}}", "quiz"] }
          }
        },
        {
          "name": "Configurar exibição do quiz",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/quiz/{{quiz_id}}", "host": ["{{base_url}}"], "path": ["quiz", "{{quiz_id}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"show_wrong_answers\": true,\n  \"show_correct_answers\": true,\n  \"show_points\": true\n}"
            }
          }
        },
        {
          "name": "Adicionar pergunta ao quiz",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/quiz/{{quiz_id}}/questions", "host": ["{{base_url}}"], "path": ["quiz", "{{quiz_id}}", "questions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statement\": \"O que é o ActiveRecord no Rails?\",\n  \"points\": 2,\n  \"alternatives\": [\n    { \"text\": \"O ORM do Rails para interagir com o banco de dados\", \"correct\": true },\n    { \"text\": \"Um sistema de rotas\", \"correct\": false },\n    { \"text\": \"Uma gem de autenticação\", \"correct\": false },\n    { \"text\": \"O sistema de templates do Rails\", \"correct\": false }\n  ]\n}"
            }
          }
        },
        {
          "name": "Listar perguntas do quiz",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/quiz/{{quiz_id}}/questions", "host": ["{{base_url}}"], "path": ["quiz", "{{quiz_id}}", "questions"] }
          }
        },
        {
          "name": "Adicionar alternativa a uma pergunta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/questions/{{question_id}}/alternatives", "host": ["{{base_url}}"], "path": ["questions", "{{question_id}}", "alternatives"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Nova alternativa\",\n  \"correct\": false\n}"
            }
          }
        },
        {
          "name": "Listar alternativas da pergunta",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/questions/{{question_id}}/alternatives", "host": ["{{base_url}}"], "path": ["questions", "{{question_id}}", "alternatives"] }
          }
        }
      ]
