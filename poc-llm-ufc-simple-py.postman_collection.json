    {
      "name": "Quiz — IA",
      "item": [
        {
          "name": "Gerar quiz via IA (5 perguntas)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/modules/{{module_id}}/quiz/gerar?quantidade=5",
              "host": ["{{base_url}}"],
              "path": ["modules", "{{module_id}}", "quiz", "gerar"],
              "query": [{ "key": "quantidade", "value": "5" }]
            }
          }
        },
        {
          "name": "Ver quiz pendente",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/modules/{{module_id}}/quiz/pendente", "host": ["{{base_url}}"], "path": ["modules", "{{module_id}}", "quiz", "pendente"] }
